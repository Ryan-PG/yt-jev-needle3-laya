# Server configuration.
# Copy this file to `.env` and adjust if needed. Every value has a working default.

# Port the Express API listens on.
PORT=8787

# Origin allowed to call the API directly (the Vite dev server proxies /api, so this
# only matters if you point the frontend at the API from another origin).
CLIENT_ORIGIN=http://localhost:5173

# --- JEV (TypeSafe System One) -------------------------------------------------
# Documented API base URL and model. See https://docs.typesafe.ai/api
JEV_BASE_URL=https://api.typesafe.ai/v1
JEV_MODEL=jev-latest

# Per-request timeout for a single JEV batch call, in milliseconds.
JEV_TIMEOUT_MS=180000

# --- LLM competition -----------------------------------------------------------
# Per-request timeout for a single LLM batch call, in milliseconds.
LLM_TIMEOUT_MS=180000

# How long an in-memory benchmark session (and the credentials it holds) is kept
# before it is dropped, in milliseconds. Nothing is ever written to disk.
SESSION_TTL_MS=1800000

# API keys are NEVER read from this file. JEV tokens and LLM API keys are entered
# in the UI, sent to the API over the wire, and held in server memory for the
# lifetime of a single benchmark session only.
